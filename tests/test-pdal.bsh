#!/usr/bin/env bash

if [ -z "${VSI_COMMON_DIR+set}" ]; then
  VSI_COMMON_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.."; pwd)"
fi

source "${VSI_COMMON_DIR}/tests/testlib.bsh"
source "${VSI_COMMON_DIR}/tests/test_utils.bsh"

: ${DOCKER=docker}

function run_pdal()
{
  local opts=(
    --rm
    -e PROJ_NETWORK=ON
    -e PROJ_USER_WRITABLE_DIRECTORY="/tmp/proj"
    "vsiri/blueprint_test:test_pdal"
  )
  local result="$(${DOCKER} run "${opts[@]}" bash -c "
    source /venv/bin/activate
    ${@}
  ")"
  echo "${result}"
}


if ! command -v "${DOCKER}" &> /dev/null; then
  skip_next_test
fi
begin_test "PDAL"
(
  setup_test

  DOCKER_IMAGE="vsiri/blueprint_test:test_pdal"

  # command line PDAL version
  RESULT="$(run_pdal 'pdal --version')"
  assert_sub_str "${RESULT}" "pdal 2.10.1"

  # python PDAL version
  RESULT="$(run_pdal 'python -c "import pdal; print(pdal.info.version)"')"
  assert_str_eq "${RESULT}" "2.10.1"

  # test for expected ldd results
  function ldd_pdal() {
    local wholename="${1}"
    local result="$(run_pdal 'find /venv -wholename '${wholename}' | head -n1 | xargs ldd')"
    local libs=( libgdal libgeos libgeos_c libgeotiff libopenjp2 libpdalcpp libproj libtiff )
    for lib in "${libs[@]}"; do
      assert_sub_str "${result}" "pdal.libs/${lib}"
    done
  }

  ldd_pdal '*/libpdalpython*.so'
  ldd_pdal '*/pdal.scripts/pdal'

)
end_test


# test WGS84 to EGM96 vertical datum transform using PDAL
# this requires PROJ_NETWORK=ON to download EGM96 grid files
if ! command -v "${DOCKER}" &> /dev/null; then
  skip_next_test
fi
begin_test "PDAL vertical datum"
(
  setup_test

  RESULT="$(run_pdal 'python - << 'EOF'
import numpy as np
from numpy.lib.recfunctions import structured_to_unstructured
import pdal

src_epsg = "EPSG:4979"
src_pt = [-84.045948, 39.827820, 215.134]

dst_epsg = "EPSG:9707"
dst_pt = [-84.045948, 39.827820, 249.0]

lon = [src_pt[0], src_pt[0] + 0.01]
lat = [src_pt[1], src_pt[1] + 0.01]
alt = [src_pt[2], src_pt[2] + 10]
src_bounds = f"({lon}, {lat}, {alt})"

pipeline = pdal.Pipeline()
pipeline |= pdal.Reader.faux(filename="", mode="constant", count=10, bounds=src_bounds, override_srs=src_epsg)
pipeline |= pdal.Filter.reprojection(out_srs=dst_epsg)
pipeline.execute()

array = pipeline.arrays[0]
result = structured_to_unstructured(array[["X", "Y", "Z"]])[0, :]

np.testing.assert_allclose(result[0:2], dst_pt[0:2], rtol=0, atol=1e-7)
np.testing.assert_allclose(result[-1], dst_pt[-1], rtol=0, atol=0.10)

print("success")
EOF
')"
  assert_str_eq "${RESULT}" "success"

)
end_test
