#!/usr/bin/env bash

if [ -z "${VSI_COMMON_DIR+set}" ]; then
  VSI_COMMON_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.."; pwd)"
fi

source "${VSI_COMMON_DIR}/tests/testlib.bsh"
source "${VSI_COMMON_DIR}/tests/test_utils.bsh"

: ${DOCKER=docker}

if ! command -v "${DOCKER}" &> /dev/null; then
  skip_next_test
fi
begin_test "mtp"
(
  setup_test

  DOCKER_IMAGE="vsiri/blueprint_test:test_mtp"

  # test DCNv3 import
  function load_dcnv3()
  {
    local script="if True:
      import torch
      import DCNv3
      print('success')
    "
    local opts=(
      --rm
      --entrypoint ""
      "${DOCKER_IMAGE}"
      python -c "${script}"
    )
    local result="$("${DOCKER}" run "${opts[@]}")"
    echo "${result}"
  }

  RESULT="$(load_dcnv3)"
  CONTAINS='success'
  assert_sub_str "${RESULT}" "${CONTAINS}"
)
end_test
